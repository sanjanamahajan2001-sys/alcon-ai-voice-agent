{
  "flow_id": "inbound_receptionist",
  "version": 6,
  "status": "draft",
  "name": "Inbound Receptionist",
  "nodes": [
    {
      "id": "start",
      "type": "startNode",
      "data": { "label": "Start" },
      "position": { "x": 500, "y": 0 }
    },
    {
      "id": "init_context",
      "type": "contextLogicNode",
      "data": { "label": "Receptionist Initialization" },
      "position": { "x": 500, "y": 100 }
    },
    {
      "id": "greeting",
      "type": "messageNode",
      "data": {
        "label": "Welcome to Alcon Hyundai. I am your AI assistant. How can I help you today? Are you looking for a new car enquiry or service assistance?"
      },
      "position": { "x": 500, "y": 200 }
    },
    {
      "id": "intent_check",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 500, "y": 320 }
    },
    {
      "id": "sales_path",
      "type": "conditionNode",
      "data": {
        "label": "name_known",
        "condition": "name not in [None, 'Customer', 'Unknown']"
      },
      "position": { "x": 200, "y": 450 }
    },
    {
      "id": "ask_name_sales",
      "type": "messageNode",
      "data": {
        "label": "Great! I can certainly help with your new car enquiry. May I know your name please?"
      },
      "position": { "x": 50, "y": 550 }
    },
    {
      "id": "capture_name_sales",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 50, "y": 670 }
    },
    {
      "id": "ask_model",
      "type": "messageNode",
      "data": {
        "label": "Thank you {{name}}. Which model are you interested in today? I can help with pricing, features, or EMI details."
      },
      "position": { "x": 200, "y": 800 }
    },
    {
      "id": "sales_query_loop",
      "type": "conditionNode",
      "data": { "label": "Query Intent Check" },
      "position": { "x": 200, "y": 920 }
    },
    {
      "id": "kb_handler_sales",
      "type": "knowledgeBaseNode",
      "data": { "label": "Knowledge Base Handler", "capability": "query" },
      "position": { "x": 50, "y": 1050 }
    },
    {
      "id": "transfer_sales",
      "type": "actionNode",
      "data": { "label": "Transfer to Sales", "action_type": "transfer_sales", "capability": "transfer" },
      "position": { "x": 350, "y": 1050 }
    },
    {
      "id": "service_path",
      "type": "conditionNode",
      "data": {
        "label": "name_known",
        "condition": "name not in [None, 'Customer', 'Unknown']"
      },
      "position": { "x": 800, "y": 450 }
    },
    {
      "id": "ask_name_service",
      "type": "messageNode",
      "data": {
        "label": "Understood. I can help you with your service booking. May I know your name please?"
      },
      "position": { "x": 950, "y": 550 }
    },
    {
      "id": "capture_name_service",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 950, "y": 670 }
    },
    {
      "id": "ask_reg_service",
      "type": "messageNode",
      "data": {
        "label": "Thank you {{name}}. To proceed, could you please share your vehicle registration number?"
      },
      "position": { "x": 800, "y": 800 }
    },
    {
      "id": "capture_reg_service",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 800, "y": 920 }
    },
    {
      "id": "check_service_due",
      "type": "actionNode",
      "data": { "label": "Check Service Due", "action_type": "check_service_due" },
      "position": { "x": 800, "y": 1040 }
    },
    {
      "id": "service_due_path",
      "type": "conditionNode",
      "data": { "label": "Is Service Due", "condition": "is_due == True" },
      "position": { "x": 800, "y": 1160 }
    },
    {
      "id": "verify_due_msg",
      "type": "messageNode",
      "data": {
        "label": "Thank you. I've verified your record. I see your {{car}} was last serviced on {{last_service_date}}, and your next appointment is now due. Would you like to book it today?"
      },
      "position": { "x": 700, "y": 1280 }
    },
    {
      "id": "verify_not_due_msg",
      "type": "messageNode",
      "data": {
        "label": "Thank you. I've checked our records and your {{car}} service is not yet due. It is scheduled for {{service_due_date}}. Is there anything else I can help you with today?"
      },
      "position": { "x": 950, "y": 1280 }
    },
    {
      "id": "check_booking",
      "type": "conditionNode",
      "data": { "label": "User says Yes" },
      "position": { "x": 700, "y": 1400 }
    },
    {
      "id": "service_query_loop",
      "type": "conditionNode",
      "data": { "label": "Query Intent Check" },
      "position": { "x": 950, "y": 1400 }
    },
    {
      "id": "ask_date",
      "type": "messageNode",
      "data": { "label": "Great. What date would you prefer for the service?" },
      "position": { "x": 550, "y": 1520 }
    },
    {
      "id": "capture_date_service",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 550, "y": 1640 }
    },
    {
      "id": "collect_mileage",
      "type": "messageNode",
      "data": { "label": "Got it. Available on {{confirmed_date}}. What's the current mileage of your car?" },
      "position": { "x": 550, "y": 1760 }
    },
    {
      "id": "capture_mileage_service",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 550, "y": 1880 }
    },
    {
      "id": "ask_concerns",
      "type": "messageNode",
      "data": { "label": "Got it. And are there any specific concerns or issues with the car?" },
      "position": { "x": 550, "y": 2000 }
    },
    {
      "id": "capture_concerns_service",
      "type": "conditionNode",
      "data": { "label": "Consent/Identity Check" },
      "position": { "x": 550, "y": 2120 }
    },
    {
      "id": "pick_drop_offer",
      "type": "messageNode",
      "data": { "label": "I've noted those points. We offer free Pick and Drop service. Would you like to avail this?" },
      "position": { "x": 550, "y": 2240 }
    },
    {
      "id": "pick_drop_check",
      "type": "conditionNode",
      "data": { "label": "User says Yes" },
      "position": { "x": 550, "y": 2360 }
    },
    {
      "id": "final_booking_sync",
      "type": "actionNode",
      "data": { "label": "Confirm Booking", "action_type": "final_booking_sync" },
      "position": { "x": 550, "y": 2480 }
    },
    {
      "id": "confirm_valet",
      "type": "messageNode",
      "data": {
        "label": "Wonderful {{salutation}}. Your service is confirmed. At Alcon, we provide a 50-point safety check and use only genuine Hyundai parts to ensure your vehicle's peak performance. Your Advisor, Amit Shah, will greet you upon arrival and walk you through the repair order details. You'll receive an SMS shortly. Have a great day!"
      },
      "position": { "x": 450, "y": 2600 }
    },
    {
      "id": "confirm_self",
      "type": "messageNode",
      "data": {
        "label": "Wonderful {{salutation}}. Your service is confirmed. At Alcon, we provide a 50-point safety check and use only genuine Hyundai parts. Your Advisor, Amit Shah, will greet you upon arrival. You'll receive an SMS shortly. Have a great day!"
      },
      "position": { "x": 650, "y": 2600 }
    },
    {
      "id": "no_booking",
      "type": "messageNode",
      "data": { "label": "Understood {{salutation}}. I'll make a note of it. Have a great day!" },
      "position": { "x": 800, "y": 1520 }
    },
    {
      "id": "kb_handler_service",
      "type": "knowledgeBaseNode",
      "data": { "label": "Knowledge Base Handler", "capability": "query" },
      "position": { "x": 1050, "y": 1520 }
    },
    {
      "id": "end",
      "type": "endNode",
      "data": { "label": "Hangup" },
      "position": { "x": 500, "y": 2800 }
    }
  ],
  "edges": [
