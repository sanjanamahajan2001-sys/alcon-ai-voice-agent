{
  "flow_id": "service_booking_prod",
  "name": "Service Booking (Production)",
  "description": "Enterprise-grade operational workflow with 100% parity to the original backend.",
  "nodes": [
    {
      "id": "start",
      "type": "startNode",
      "position": { "x": 400, "y": 0 },
      "data": { "label": "Start Call" }
    },
    {
      "id": "crm_lookup",
      "type": "apiNode",
      "position": { "x": 400, "y": 100 },
      "data": { "label": "/mock/crm/{{from}}" }
    },
    {
      "id": "intro",
      "type": "messageNode",
      "position": { "x": 400, "y": 200 },
      "data": { "label": "Hello, I'm Supriya from Alcon. Am I speaking with {{name}} {{salutation}}?" }
    },
    {
      "id": "check_id",
      "type": "conditionNode",
      "position": { "x": 400, "y": 350 },
      "data": { "label": "Identity Verification" }
    },
    {
      "id": "handle_wrong",
      "type": "messageNode",
      "position": { "x": 700, "y": 350 },
      "data": { "label": "I'm so sorry! I must have the wrong number. I'll update our records immediately. Have a nice day!" }
    },
    {
      "id": "ask_callback",
      "type": "messageNode",
      "position": { "x": 100, "y": 350 },
      "data": { "label": "No problem {{salutation}}. I completely understand. When would be a more convenient time for me to call you back?" }
    },
    {
      "id": "confirm_callback",
      "type": "messageNode",
      "position": { "x": 100, "y": 500 },
      "data": { "label": "Got it. I've scheduled a reminder to call you back at {{callback_time}}. Have a great day!" }
    },
    {
      "id": "verify_due",
      "type": "messageNode",
      "position": { "x": 400, "y": 500 },
      "data": { "label": "Great! I've verified your record {{salutation}} {{name}}. I see your {{car_model}} was last serviced on {{last_svc_formatted}}, and your next appointment is now due. Would you like to book it today?" }
    },
    {
      "id": "check_booking",
      "type": "conditionNode",
      "position": { "x": 400, "y": 650 },
      "data": { "label": "User says Yes" }
    },
    {
      "id": "ask_date",
      "type": "messageNode",
      "position": { "x": 400, "y": 800 },
      "data": { "label": "Great. What date would you prefer for the service?" }
    },
    {
      "id": "collect_mileage",
      "type": "messageNode",
      "position": { "x": 400, "y": 920 },
      "data": { "label": "Got it. Available on {{confirmed_date}}. What's the current mileage of your car?" }
    },
    {
      "id": "ask_concerns",
      "type": "messageNode",
      "position": { "x": 400, "y": 1040 },
      "data": { "label": "Got it. And are there any specific concerns or issues with the car?" }
    },
    {
      "id": "pick_drop_offer",
      "type": "messageNode",
      "position": { "x": 400, "y": 1160 },
      "data": { "label": "I've noted those points. We offer free Pick and Drop service. Would you like to avail this?" }
    },
    {
      "id": "pick_drop_check",
      "type": "conditionNode",
      "position": { "x": 400, "y": 1280 },
      "data": { "label": "User says Yes" }
    },
    {
      "id": "confirm_valet",
      "type": "messageNode",
      "position": { "x": 200, "y": 1420 },
      "data": { "label": "Wonderful {{salutation}}. Your service is confirmed for {{confirmed_date}}. At Alcon, we provide a 50-point safety check and use only genuine Hyundai parts to ensure your vehicle's peak performance. Your Advisor, Amit Shah, will greet you upon arrival and walk you through the repair order details. A confirmation SMS has been sent to you. Have a great day!" }
    },
    {
      "id": "confirm_self",
      "type": "messageNode",
      "position": { "x": 600, "y": 1420 },
      "data": { "label": "Wonderful {{salutation}}. Your service is confirmed for {{confirmed_date}}. At Alcon, we provide a 50-point safety check and use only genuine Hyundai parts to ensure your vehicle's peak performance. Your Advisor, Amit Shah, will greet you upon arrival and walk you through the repair order details. A confirmation SMS has been sent to you. Have a great day!" }
    },
    {
      "id": "end",
      "type": "endNode",
      "position": { "x": 400, "y": 1550 },
      "data": { "label": "Hangup" }
    },
    {
      "id": "no_booking",
      "type": "messageNode",
      "position": { "x": 650, "y": 650 },
      "data": { "label": "Understood {{salutation}}. {{callback_confirmation}}. Have a great day!" }
    },
    {
      "id": "not_due_message",
      "type": "messageNode",
      "position": { "x": 600, "y": 500 },
      "data": { "label": "I see your {{car_model}} was last serviced recently on {{last_svc_formatted}}. Since your service is only due every {{service_due_months}} months, you are all set for now! Have a wonderful day!" }
    },
    {
      "id": "check_slot_action",
      "type": "actionNode",
      "position": { "x": 400, "y": 860 },
      "data": { "label": "validate_slot_request", "action_type": "validate_slot_request" }
    },
    {
      "id": "suggest_alternate_slots",
      "type": "messageNode",
      "position": { "x": 650, "y": 860 },
      "data": { "label": "I'm sorry, that timing is fully booked. We have Saturday slots available at 10:00 AM and 03:00 PM, or would Friday evening at 05:30 PM work better?" }
    },
    {
      "id": "suggest_period_choices_node",
      "type": "messageNode",
      "position": { "x": 150, "y": 860 },
      "data": { "label": "{{slot_choice_prefix}} On {{requested_day_rel}} we have slots at {{matching_period_slots_text}}. Which one works better for you?" }
    },
    {
      "id": "emergency_breakdown_node",
      "type": "messageNode",
      "position": { "x": 900, "y": 860 },
      "data": { "label": "I understand you have an urgent breakdown. Connecting you immediately to our Roadside Assistance supervisor." }
    },
    {
      "id": "check_counter_proposal",
      "type": "conditionNode",
      "position": { "x": 400, "y": 980 },
      "data": { "label": "Check Counter Proposal" }
    }
  ],
