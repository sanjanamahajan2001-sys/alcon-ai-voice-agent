{
  "flow_id": "pd_ready_delivery",
  "version": 1,
  "status": "master",
  "name": "Vehicle Ready & Delivery",
  "description": "Inform customer vehicle is ready and coordinate delivery.",
  "nodes": [
    {
      "id": "start",
      "type": "startNode",
      "data": { "label": "Start" },
      "position": { "x": 400, "y": 0 }
    },
    {
      "id": "crm_lookup",
      "type": "apiNode",
      "data": { "label": "http://mock/crm/{{from}}" },
      "position": { "x": 400, "y": 100 }
    },
    {
      "id": "svc_lookup",
      "type": "apiNode",
      "data": { "label": "http://mock/service_details/{{id}}" },
      "position": { "x": 400, "y": 200 }
    },
    {
      "id": "greeting",
      "type": "messageNode",
      "data": { "label": "Wonderful news {{salutation}} {{name}}! Your car is ready for delivery. We've completed {{service_summary}}. Would you like us to drop it back to your location, or will you be coming to pick it up?" },
      "position": { "x": 400, "y": 300 }
    },
    {
      "id": "check_delivery",
      "type": "conditionNode",
      "data": { "label": "delivery_option" },
      "position": { "x": 400, "y": 450 }
    },
    {
      "id": "drop_msg",
      "type": "messageNode",
      "data": { "label": "Perfect. I've scheduled the drop-off for you. Our driver will contact you shortly. Thank you!" },
      "position": { "x": 300, "y": 600 }
    },
    {
      "id": "pickup_msg",
      "type": "messageNode",
      "data": { "label": "Got it. Your car is parked at our service entrance. See you soon!" },
      "position": { "x": 500, "y": 600 }
    },
    {
      "id": "end",
      "type": "endNode",
      "data": { "label": "End" },
      "position": { "x": 400, "y": 750 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start", "target": "crm_lookup" },
    { "id": "e2", "source": "crm_lookup", "target": "svc_lookup" },
    { "id": "e3", "source": "svc_lookup", "target": "greeting" },
    { "id": "e4", "source": "greeting", "target": "check_delivery" },
    { "id": "e5", "source": "check_delivery", "target": "drop_msg", "sourceHandle": "drop" },
    { "id": "e6", "source": "check_delivery", "target": "pickup_msg", "sourceHandle": "pickup" },
    { "id": "e7", "source": "drop_msg", "target": "end" },
    { "id": "e8", "source": "pickup_msg", "target": "end" }
  ]
}
