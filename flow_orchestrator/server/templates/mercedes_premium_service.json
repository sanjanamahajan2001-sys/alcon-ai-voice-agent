      "type": "messageNode",
      "position": { "x": 400, "y": 920 },
      "data": { "label": "Noted for {{confirmed_date}}. Could you please share the current mileage on your instrument cluster?" }
    },
    {
      "id": "concierge_offer",
      "type": "messageNode",
      "position": { "x": 400, "y": 1040 },
      "data": { "label": "Thank you. For our Mercedes clients, we provide a complimentary Chauffeur-driven Pick and Drop. Would you like to avail this premium service?" }
    },
    {
      "id": "concierge_check",
      "type": "conditionNode",
      "position": { "x": 400, "y": 1160 },
      "data": { "label": "User says Yes" }
    },
    {
      "id": "confirm_mercedes",
      "type": "messageNode",
      "position": { "x": 400, "y": 1300 },
      "data": { "label": "Wonderful {{salutation}}. Your service is confirmed. We will use only genuine Mercedes-Benz parts and synthetic oil. Our Service Manager, Amit Shah, will personally oversee your vehicle. Have a great day!" }
    },
    {
      "id": "end",
      "type": "endNode",
      "position": { "x": 400, "y": 1450 },
      "data": { "label": "Hangup" }
    },
    {
      "id": "no_booking",
      "type": "messageNode",
      "position": { "x": 650, "y": 650 },
      "data": { "label": "Understood {{salutation}}. {{callback_confirmation}}. Have a great day!" }
