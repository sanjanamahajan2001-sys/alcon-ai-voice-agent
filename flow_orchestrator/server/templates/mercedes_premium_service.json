    },
    {
      "id": "ask_callback",
      "type": "messageNode",
      "position": { "x": 100, "y": 350 },
      "data": { "label": "Of course {{salutation}}. I understand you are busy. When would be a convenient time for our concierge to call you back?" }
    },
    {
      "id": "confirm_callback",
      "type": "messageNode",
      "position": { "x": 100, "y": 500 },
